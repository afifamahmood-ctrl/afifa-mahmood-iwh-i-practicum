html
  head
    title= title
    link(rel="stylesheet" href="/css/style.css")
  body
    h1 Custom Object Table
    a(href="/update-cobj") Add/Update this table
    table
      thead
        tr
          each prop in properties
            th= prop.charAt(0).toUpperCase() + prop.slice(1)
      tbody
        each record in records
          tr
            each prop in properties
              td= record.properties[prop]